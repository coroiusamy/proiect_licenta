// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

// === MODELUL UTILIZATORULUI ===

model User {
  id        Int      @id @default(autoincrement()) // ID unic, numeric
  email     String   @unique // Email-ul, trebuie să fie unic
  password  String   // parola CRIPTATĂ
  createdAt DateTime @default(now()) // Data la care s-a creat contul
}