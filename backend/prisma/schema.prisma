generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === MODELUL UTILIZATORULUI ===
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())

  googleId       String?  @unique
  authProvider   String   @default("local") // "local" sau "google"
  profilePicture String?  // URL poză de profil (de la Google sau încărcată)
  role           String   @default("patient") // "patient" sau "doctor"

  // --- Informații Personale ---
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  gender      String?
  
  // --- Biometrie (doar pentru pacienți) ---
  weight      Float?
  height      Float?

  // --- Câmpuri Medic ---
  specialty   String?  // Specializarea medicului (ex: "Cardiologie")

  // --- Câmpuri pentru Resetare Parolă ---
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  
  analysisResults AnalysisResult[]
  treatments      Treatment[]
  // Relații Doctor-Pacient
  generatedCodes  AccessCode[]      @relation("PatientCodes")
  doctorLinks     DoctorPatient[]   @relation("DoctorLinks")   // Medicul are pacienți
  patientLinks    DoctorPatient[]   @relation("PatientLinks")  // Pacientul are medici
}

// === COD DE ACCES TEMPORAR ===
model AccessCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique  // Cod unic de 6 caractere
  patientId Int
  patient   User     @relation("PatientCodes", fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Expiră după 15 minute
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// === LEGĂTURA DOCTOR-PACIENT ===
model DoctorPatient {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  doctor    User     @relation("DoctorLinks", fields: [doctorId], references: [id], onDelete: Cascade)
  patientId Int
  patient   User     @relation("PatientLinks", fields: [patientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([doctorId, patientId]) // Un medic nu poate fi legat de 2 ori de același pacient
}

// === BIBLIOTECA DE ANALIZE ===
model AnalysisType {
  id    Int     @id @default(autoincrement())
  name  String  @unique // ex: "Glicemie"
  displayName      String?
  unit  String  // ex: "mg/dL"
  
  refMin Float? // Opțional
  refMax Float? // Opțional

  // Interpretările "default"
  interpretationLow   String? @db.Text
  interpretationNormal String? @db.Text
  interpretationHigh  String? @db.Text

  // Un tip de analiză are multe rezultate și tratamente
  results    AnalysisResult[]
  treatments Treatment[]
}

// === REZULTATELE UTILIZATORILOR (JURNALUL) ===
model AnalysisResult {
  id     Int      @id @default(autoincrement())
  
  value       Float?   // Valoare numerică (ex: 105.5)
  stringValue String?  // Valoare text (ex: "Pozitiv", "Negativ")
  
  date   DateTime // Data la care a fost făcută analiza

  // Legătura către Utilizator
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       String?      // "low", "normal", "high"
  aiAdvice     String?      // textul generat de AI

  // Legătura către Tipul Analizei
  analysisTypeId Int
  analysisType   AnalysisType @relation(fields: [analysisTypeId], references: [id])
  
  notes String? @db.Text // Comentariu opțional
}

// Prețuri externe pentru Comparator (Cache)
model ExternalPrice {
  id           Int      @id @default(autoincrement())
  clinicName   String   // "Synevo", "Regina Maria", "Sante", etc.
  analysisName String   // Numele NOSTRU standard (ex: "Glicemie")
  originalName String   // Numele LOR de pe site (ex: "Glucoza serica")
  price        Float
  currency     String   @default("RON")
  url          String?  // Link direct către analiză
  lastUpdated  DateTime @default(now())

  // Cheie unică: O clinică are un singur preț pentru un tip de analiză
  @@unique([clinicName, analysisName])
}

// === TRATAMENTE PENTRU PACIENȚI ===
model Treatment {
  id             Int       @id @default(autoincrement())
  name           String    // Nume medicament (ex: "Euthyrox 50mcg")
  startDate      DateTime  // Data începerii
  endDate        DateTime? // Data încheierii (opțională)

  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  analysisTypeId Int
  analysisType   AnalysisType @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
}